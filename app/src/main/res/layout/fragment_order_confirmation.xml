<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vf_background"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/vf_on_background" />

            <TextView
                style="@style/Stitch.Typography.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Confirm Delivery"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/llBottomActions"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/stitch_margin_mobile"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Stitch.Typography.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review your delivery details" />

            <!-- Section 1: Delivery Summary -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_lg"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/stitch_rounded_lg"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/Stitch.Typography.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Summary"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditLocations"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit"
                            android:textColor="@color/vf_primary"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_edit"
                            app:iconTint="@color/vf_primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/vf_surface_container" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_md">

                        <View
                            android:id="@+id/trackLine"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="11dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="@drawable/dashed_line_vertical"
                            android:alpha="0.4"
                            app:layout_constraintBottom_toBottomOf="@id/ivDest"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ivPickup" />

                        <ImageView
                            android:id="@+id/ivPickup"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/shape_circle_outline"
                            android:contentDescription="Pickup Icon" />

                        <TextView
                            android:id="@+id/tvPickupLabel"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="PICKUP"
                            android:textAllCaps="true"
                            app:layout_constraintStart_toEndOf="@id/ivPickup"
                            app:layout_constraintTop_toTopOf="@id/ivPickup" />

                        <TextView
                            android:id="@+id/tvPickupAddress"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvPickupLabel"
                            app:layout_constraintTop_toBottomOf="@id/tvPickupLabel" />

                        <ImageView
                            android:id="@+id/ivDest"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="64dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivPickup"
                            app:srcCompat="@drawable/ic_location"
                            app:tint="@color/vf_primary"
                            android:contentDescription="Destination Icon" />

                        <TextView
                            android:id="@+id/tvDestLabel"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="DELIVER TO"
                            android:textColor="@color/vf_primary"
                            android:textAllCaps="true"
                            app:layout_constraintStart_toEndOf="@id/ivDest"
                            app:layout_constraintTop_toTopOf="@id/ivDest" />

                        <TextView
                            android:id="@+id/tvReceiverName"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestLabel"
                            app:layout_constraintTop_toBottomOf="@id/tvDestLabel" />

                        <TextView
                            android:id="@+id/tvDeliveryAddress"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvReceiverName"
                            app:layout_constraintTop_toBottomOf="@id/tvReceiverName" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Package Details -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/stitch_rounded_lg"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/Stitch.Typography.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Package Details"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditPackage"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit"
                            android:textColor="@color/vf_primary"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_edit"
                            app:iconTint="@color/vf_primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_sm"
                        app:cardBackgroundColor="#F5F7FF"
                        app:cardCornerRadius="@dimen/stitch_rounded_md"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/stitch_md">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="12dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                                app:srcCompat="@drawable/ic_package"
                                app:tint="@color/vf_primary"
                                android:background="#E5EDFF"
                                android:contentDescription="Package Icon" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/stitch_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Stitch.Typography.LabelMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ITEM"
                                    android:textAllCaps="true" />

                                <TextView
                                    android:id="@+id/tvItemDescription"
                                    style="@style/Stitch.Typography.BodyLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Payment Summary -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/stitch_rounded_lg"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <TextView
                        style="@style/Stitch.Typography.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Summary"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_md">
                        <TextView
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Charge" />
                        <TextView
                            android:id="@+id/tvDeliveryCharge"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₹0.00"
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/stitch_md"
                        android:background="@drawable/dashed_divider"
                        android:alpha="0.3" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            style="@style/Stitch.Typography.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Payable"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvTotalPayable"
                            style="@style/Stitch.Typography.HeadlineMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_alignParentEnd="true"
                            android:text="₹0.00"
                            android:textColor="@color/vf_primary"
                            android:textStyle="bold"
                            android:textSize="24sp" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                app:cardBackgroundColor="#F0F4FF"
                app:cardCornerRadius="@dimen/stitch_rounded_md"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/stitch_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_bell"
                        app:tint="@color/vf_primary"
                        android:contentDescription="Info Icon" />

                    <TextView
                        style="@style/Stitch.Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/stitch_md"
                        android:layout_weight="1"
                        android:text="Payment is required before delivery processing. After successful payment, your delivery request will be processed and made available to a delivery partner."
                        android:textColor="@color/vf_on_surface"
                        android:visibility="gone" />

                    <TextView
                        style="@style/Stitch.Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/stitch_md"
                        android:layout_weight="1"
                        android:text="Payment is required before delivery processing. After successful payment, your delivery request will be processed and made available to a delivery partner."
                        android:textColor="@color/vf_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/stitch_margin_mobile"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceed"
            style="@style/Stitch.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Proceed to Payment"
            android:textSize="18sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:cornerRadius="28dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

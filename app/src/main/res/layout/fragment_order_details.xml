<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vf_background"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingEnd="@dimen/stitch_md"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/vf_on_background">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        style="@style/Stitch.Typography.HeadlineMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Details"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvOrderID"
                        style="@style/Stitch.Typography.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_pill_white"
                    android:backgroundTint="@color/vf_primary"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="RtlSymmetry">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_pill_white"
                        android:backgroundTint="@color/white" />

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        style="@style/Stitch.Typography.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="IN TRANSIT"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/stitch_margin_mobile"
            android:paddingBottom="24dp">

            <!-- Delivery Route Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <TextView
                        style="@style/Stitch.Typography.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery Route" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_lg">

                        <View
                            android:id="@+id/vRouteLine"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="9dp"
                            android:background="@drawable/dashed_line_vertical"
                            app:layout_constraintBottom_toBottomOf="@id/ivDropIcon"
                            app:layout_constraintStart_toStartOf="@id/ivPickupIcon"
                            app:layout_constraintTop_toTopOf="@id/ivPickupIcon" />

                        <ImageView
                            android:id="@+id/ivPickupIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_timeline_pending"
                            app:tint="@color/vf_primary"
                            android:contentDescription="Pickup Icon" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="PICKUP"
                            app:layout_constraintStart_toEndOf="@id/ivPickupIcon"
                            app:layout_constraintTop_toTopOf="@id/ivPickupIcon" />

                        <TextView
                            android:id="@+id/tvPickupAddress"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:layout_marginTop="16dp"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivPickupIcon"
                            app:layout_constraintTop_toTopOf="@id/ivPickupIcon" />

                        <ImageView
                            android:id="@+id/ivDropIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="32dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvPickupAddress"
                            app:srcCompat="@drawable/ic_location"
                            app:tint="@color/vf_primary"
                            android:contentDescription="Destination Icon" />

                        <TextView
                            android:id="@+id/tvDestLabel"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="DESTINATION"
                            app:layout_constraintStart_toEndOf="@id/ivDropIcon"
                            app:layout_constraintTop_toTopOf="@id/ivDropIcon" />

                        <TextView
                            android:id="@+id/tvDestName"
                            style="@style/Stitch.Typography.BodyLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Receiver"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestLabel"
                            app:layout_constraintTop_toBottomOf="@id/tvDestLabel" />

                        <TextView
                            android:id="@+id/tvDestPhone"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface_variant"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestName"
                            app:layout_constraintTop_toBottomOf="@id/tvDestName" />

                        <TextView
                            android:id="@+id/tvDropAddress"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestName"
                            app:layout_constraintTop_toBottomOf="@id/tvDestPhone" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pickup OTP Card (Visible only when partner is assigned and pickup is pending) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPickupOtp"
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                android:visibility="gone"
                app:cardBackgroundColor="#F0F4FF"
                app:cardCornerRadius="@dimen/stitch_rounded_lg"
                app:strokeColor="@color/vf_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:srcCompat="@drawable/ic_verified"
                            app:tint="@color/vf_primary"
                            android:contentDescription="Security Icon" />

                        <TextView
                            style="@style/Stitch.Typography.TitleLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Pickup OTP"
                            android:textColor="@color/vf_primary"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyOtp"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copy OTP"
                            android:textColor="@color/vf_primary"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_content_copy"
                            app:iconTint="@color/vf_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPickupOtp"
                        style="@style/Stitch.Typography.HeadlineMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.2"
                        android:text="123456"
                        android:textColor="@color/vf_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Stitch.Typography.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:text="Share this OTP with your delivery partner upon pickup arrival."
                        android:textColor="@color/vf_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery Partner Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                app:cardBackgroundColor="@color/white">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/stitch_md">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPartnerAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:srcCompat="@drawable/ic_user_circle"
                        android:contentDescription="Partner Avatar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/stitch_md"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/ivPartnerAvatar"
                        app:layout_constraintEnd_toStartOf="@id/btnCall"
                        app:layout_constraintStart_toEndOf="@id/ivPartnerAvatar"
                        app:layout_constraintTop_toTopOf="@id/ivPartnerAvatar">

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DELIVERY PARTNER" />

                        <TextView
                            android:id="@+id/tvPartnerName"
                            style="@style/Stitch.Typography.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unassigned Partner"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                app:srcCompat="@drawable/ic_star"
                                app:tint="#FFC107"
                                android:contentDescription="Star Rating" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="4.8 (120+ deliveries)" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCall"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:backgroundTint="#EAF1FF"
                        app:icon="@drawable/ic_phone"
                        app:iconTint="@color/vf_primary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Details Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Stitch.Card.Level1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/stitch_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/stitch_md">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:srcCompat="@drawable/ic_package"
                                app:tint="@color/vf_outline"
                                android:contentDescription="Package Icon" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="PACKAGE" />
                        </LinearLayout>

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stitch_md"
                            android:text="TYPE" />

                        <TextView
                            android:id="@+id/tvItemType"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Standard Package"
                            android:textColor="@color/vf_on_surface" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="WEIGHT" />

                        <TextView
                            android:id="@+id/tvItemWeight"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0 kg"
                            android:textColor="@color/vf_on_surface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Stitch.Card.Level1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/stitch_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/stitch_md">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:srcCompat="@drawable/ic_credit_card"
                                app:tint="@color/vf_outline"
                                android:contentDescription="Payment Icon" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="PAYMENT" />
                        </LinearLayout>

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stitch_md"
                            android:text="METHOD" />

                        <TextView
                            android:id="@+id/tvPaymentMethod"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Online Gateway"
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="AMOUNT" />

                        <TextView
                            android:id="@+id/tvPaymentAmount"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="STATUS" />

                        <TextView
                            android:id="@+id/tvPaymentStatus"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_success"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Delivery Timeline Card (Strictly 3 Steps: Order Placed, Package Picked Up, Complete Delivery) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <TextView
                        style="@style/Stitch.Typography.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery Timeline" />

                    <LinearLayout
                        android:id="@+id/llTimelineItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_lg"
                        android:orientation="vertical">

                        <!-- Step 1: Order Placed -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/stitch_md">
                            <ImageView
                                android:id="@+id/ivIcon1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:srcCompat="@drawable/ic_timeline_checked"
                                android:contentDescription="Order Placed" />
                            <TextView
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/ivIcon1"
                                android:layout_marginStart="12dp"
                                android:text="Order Placed"
                                android:textColor="@color/vf_on_surface"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvTime1"
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="" />
                        </RelativeLayout>

                        <!-- Step 2: Package Picked Up -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/stitch_md">
                            <ImageView
                                android:id="@+id/ivIcon2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:srcCompat="@drawable/ic_timeline_checked"
                                android:contentDescription="Package Picked Up" />
                            <TextView
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/ivIcon2"
                                android:layout_marginStart="12dp"
                                android:text="Package Picked Up"
                                android:textColor="@color/vf_on_surface"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvTime2"
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="" />
                        </RelativeLayout>

                        <!-- Step 3: Complete Delivery -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/ivIcon3"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:srcCompat="@drawable/ic_timeline_pending"
                                android:contentDescription="Complete Delivery" />
                            <TextView
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/ivIcon3"
                                android:layout_marginStart="12dp"
                                android:text="Complete Delivery"
                                android:textColor="@color/vf_on_surface"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvTime3"
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="" />
                        </RelativeLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Give Feedback Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGiveFeedback"
                style="@style/Stitch.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/stitch_lg"
                android:text="Give Feedback"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

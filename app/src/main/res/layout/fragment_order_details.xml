<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vf_background"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingEnd="@dimen/stitch_md"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/vf_on_background">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        style="@style/Stitch.Typography.HeadlineMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order Details"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvOrderID"
                        style="@style/Stitch.Typography.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order #QD-9284" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_pill_white"
                    android:backgroundTint="@color/vf_primary"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="RtlSymmetry">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_pill_white"
                        android:backgroundTint="@color/white" />

                    <TextView
                        style="@style/Stitch.Typography.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="IN TRANSIT"
                        android:textColor="@color/white"
                        android:textSize="10sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/stitch_margin_mobile"
            android:paddingBottom="24dp">

            <!-- Delivery In Progress Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/stitch_md">

                    <TextView
                        android:id="@+id/tvProgressTitle"
                        style="@style/Stitch.Typography.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery In Progress"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintBottom_toBottomOf="@id/tvProgressTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvProgressTitle"
                        app:srcCompat="@drawable/ic_local_shipping"
                        app:tint="@color/vf_primary" />

                    <!-- Progress Stepper -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clProgressStepper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_xl"
                        app:layout_constraintTop_toBottomOf="@id/tvProgressTitle">

                        <View
                            android:id="@+id/lineProgress"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:background="@color/vf_surface_container_high"
                            app:layout_constraintBottom_toBottomOf="@id/ivStep1"
                            app:layout_constraintEnd_toEndOf="@id/ivStep4"
                            app:layout_constraintStart_toStartOf="@id/ivStep1"
                            app:layout_constraintTop_toTopOf="@id/ivStep1" />

                        <View
                            android:id="@+id/lineProgressActive"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:background="@color/vf_primary"
                            app:layout_constraintBottom_toBottomOf="@id/ivStep1"
                            app:layout_constraintEnd_toEndOf="@id/ivStep3"
                            app:layout_constraintStart_toStartOf="@id/ivStep1"
                            app:layout_constraintTop_toTopOf="@id/ivStep1" />

                        <ImageView
                            android:id="@+id/ivStep1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:layout_constraintEnd_toStartOf="@id/ivStep2"
                            app:layout_constraintHorizontal_chainStyle="spread_inside"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_timeline_checked" />

                        <ImageView
                            android:id="@+id/ivStep2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:layout_constraintEnd_toStartOf="@id/ivStep3"
                            app:layout_constraintStart_toEndOf="@id/ivStep1"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_timeline_checked" />

                        <ImageView
                            android:id="@+id/ivStep3"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:layout_constraintEnd_toStartOf="@id/ivStep4"
                            app:layout_constraintStart_toEndOf="@id/ivStep2"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_timeline_active" />

                        <ImageView
                            android:id="@+id/ivStep4"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivStep3"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_timeline_pending" />

                        <TextView
                            android:id="@+id/tvStep1"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Accepted"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@id/ivStep1"
                            app:layout_constraintStart_toStartOf="@id/ivStep1"
                            app:layout_constraintTop_toBottomOf="@id/ivStep1" />

                        <TextView
                            android:id="@+id/tvStep2"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Picked Up"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@id/ivStep2"
                            app:layout_constraintStart_toStartOf="@id/ivStep2"
                            app:layout_constraintTop_toBottomOf="@id/ivStep2" />

                        <TextView
                            android:id="@+id/tvStep3"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="In Transit"
                            android:textColor="@color/vf_primary"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@id/ivStep3"
                            app:layout_constraintStart_toStartOf="@id/ivStep3"
                            app:layout_constraintTop_toBottomOf="@id/ivStep3" />

                        <TextView
                            android:id="@+id/tvStep4"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Delivered"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="@id/ivStep4"
                            app:layout_constraintStart_toStartOf="@id/ivStep4"
                            app:layout_constraintTop_toBottomOf="@id/ivStep4" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery Route Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <TextView
                        style="@style/Stitch.Typography.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery Route" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_lg">

                        <View
                            android:id="@+id/vRouteLine"
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="9dp"
                            android:background="@drawable/dashed_line_vertical"
                            app:layout_constraintBottom_toBottomOf="@id/ivDropIcon"
                            app:layout_constraintStart_toStartOf="@id/ivPickupIcon"
                            app:layout_constraintTop_toTopOf="@id/ivPickupIcon" />

                        <ImageView
                            android:id="@+id/ivPickupIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_timeline_pending"
                            app:tint="@color/vf_primary" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="PICKUP"
                            app:layout_constraintStart_toEndOf="@id/ivPickupIcon"
                            app:layout_constraintTop_toTopOf="@id/ivPickupIcon" />

                        <TextView
                            android:id="@+id/tvPickupAddress"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:layout_marginTop="16dp"
                            android:text="123 Tech Park, Sharma Heights\nBengaluru, Karnataka 560001"
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ivPickupIcon"
                            app:layout_constraintTop_toTopOf="@id/ivPickupIcon" />

                        <ImageView
                            android:id="@+id/ivDropIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="32dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvPickupAddress"
                            app:srcCompat="@drawable/ic_location"
                            app:tint="@color/vf_primary" />

                        <TextView
                            android:id="@+id/tvDestLabel"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="DESTINATION"
                            app:layout_constraintStart_toEndOf="@id/ivDropIcon"
                            app:layout_constraintTop_toTopOf="@id/ivDropIcon" />

                        <TextView
                            android:id="@+id/tvDestName"
                            style="@style/Stitch.Typography.BodyLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Rahul Sharma"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestLabel"
                            app:layout_constraintTop_toBottomOf="@id/tvDestLabel" />

                        <TextView
                            android:id="@+id/tvDestPhone"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="+91 XXXXX XXXXX"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestName"
                            app:layout_constraintTop_toBottomOf="@id/tvDestName" />

                        <TextView
                            android:id="@+id/tvDropAddress"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="456 Elm Street, Apt 4B, Sharma Heights"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/tvDestPhone"
                            app:layout_constraintTop_toBottomOf="@id/tvDestPhone" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Delivery Partner Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/stitch_md">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivPartnerAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:srcCompat="@drawable/ic_user_circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/stitch_md"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/ivPartnerAvatar"
                        app:layout_constraintEnd_toStartOf="@id/btnCall"
                        app:layout_constraintStart_toEndOf="@id/ivPartnerAvatar"
                        app:layout_constraintTop_toTopOf="@id/ivPartnerAvatar">

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DELIVERY PARTNER" />

                        <TextView
                            android:id="@+id/tvPartnerName"
                            style="@style/Stitch.Typography.BodyLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rahul Sharma"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                app:srcCompat="@drawable/ic_star"
                                app:tint="@color/vf_warning" />

                            <TextView
                                android:id="@+id/tvPartnerRating"
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="4.9" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCall"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:backgroundTint="@color/vf_secondary_container"
                        app:icon="@drawable/ic_phone"
                        app:iconTint="@color/vf_on_secondary_container"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Package and Payment Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Stitch.Card.Level1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/stitch_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/stitch_md">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:srcCompat="@drawable/ic_package"
                                app:tint="@color/vf_outline" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="PACKAGE" />
                        </LinearLayout>

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stitch_md"
                            android:text="ITEM" />

                        <TextView
                            android:id="@+id/tvItemName"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Document Express"
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TYPE" />

                        <TextView
                            android:id="@+id/tvItemType"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Small Package"
                            android:textColor="@color/vf_on_surface" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="WEIGHT" />

                        <TextView
                            android:id="@+id/tvItemWeight"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.5 kg"
                            android:textColor="@color/vf_on_surface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Stitch.Card.Level1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/stitch_xs"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/stitch_md">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                app:srcCompat="@drawable/ic_credit_card"
                                app:tint="@color/vf_outline" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="PAYMENT" />
                        </LinearLayout>

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/stitch_md"
                            android:text="METHOD" />

                        <TextView
                            android:id="@+id/tvPaymentMethod"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPI"
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="AMOUNT" />

                        <TextView
                            android:id="@+id/tvPaymentAmount"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹75"
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="STATUS" />

                        <TextView
                            android:id="@+id/tvPaymentStatus"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paid"
                            android:textColor="@color/vf_success"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Delivery Timeline Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <TextView
                        style="@style/Stitch.Typography.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery Timeline" />

                    <LinearLayout
                        android:id="@+id/llTimelineItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_lg"
                        android:orientation="vertical">

                        <!-- Simplified Timeline Items -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/stitch_md">
                            <ImageView
                                android:id="@+id/ivIcon1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:srcCompat="@drawable/ic_timeline_checked" />
                            <TextView
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/ivIcon1"
                                android:layout_marginStart="12dp"
                                android:text="Order Placed"
                                android:textColor="@color/vf_on_surface" />
                            <TextView
                                style="@style/Stitch.Typography.BodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"

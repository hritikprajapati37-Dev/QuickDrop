<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Deliveries"
            app:titleCentered="true"
            app:titleTextAppearance="@style/ToolbarTitleBold"
            app:titleTextColor="@color/vf_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/stitch_margin_mobile"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Stitch.Typography.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your active deliveries"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveCount"
                style="@style/Stitch.Typography.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 active deliveries" />

            <!-- Active Delivery Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDelivery"
                style="@style/Stitch.Card.Level1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/stitch_lg"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/stitch_md">

                    <!-- Card Header Row 1 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvOrderID"
                            style="@style/Stitch.Typography.CodeMono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textStyle="bold"
                            android:textColor="@color/vf_on_surface"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/shape_pill_white"
                            android:backgroundTint="#F0F4FF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/shape_circle_white"
                                android:backgroundTint="@color/vf_primary" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Out for Delivery"
                                android:textAllCaps="false"
                                android:textColor="@color/vf_primary" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/stitch_md"
                        android:background="@color/vf_surface_container" />

                    <!-- Card Header Row 2 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_md">

                        <TextView
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Arrival"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvETA"
                            style="@style/Stitch.Typography.HeadlineMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_primary"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Pickup/Destination -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_lg">

                        <View
                            android:layout_width="2dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="11dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:alpha="0.3"
                            android:background="@drawable/dashed_line_vertical"
                            app:layout_constraintBottom_toBottomOf="@id/ivDest"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ivPickup" />

                        <ImageView
                            android:id="@+id/ivPickup"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/shape_circle_white"
                            app:tint="@color/vf_outline_variant" />

                        <TextView
                            android:id="@+id/tvPickupLabel"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="PICKUP"
                            app:layout_constraintStart_toEndOf="@id/ivPickup"
                            app:layout_constraintTop_toTopOf="@id/ivPickup" />

                        <TextView
                            android:id="@+id/tvPickupVal"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="@id/tvPickupLabel"
                            app:layout_constraintTop_toBottomOf="@id/tvPickupLabel" />

                        <ImageView
                            android:id="@+id/ivDest"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="48dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivPickup"
                            app:srcCompat="@drawable/ic_destination_ring" />

                        <TextView
                            android:id="@+id/tvDestLabel"
                            style="@style/Stitch.Typography.LabelMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/stitch_md"
                            android:text="DESTINATION"
                            android:textColor="@color/vf_primary"
                            app:layout_constraintStart_toEndOf="@id/ivDest"
                            app:layout_constraintTop_toTopOf="@id/ivDest" />

                        <TextView
                            android:id="@+id/tvDestVal"
                            style="@style/Stitch.Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/vf_on_surface"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="@id/tvDestLabel"
                            app:layout_constraintTop_toBottomOf="@id/tvDestLabel" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Timeline Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_xl"
                        android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:background="@color/vf_primary"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/ivOut"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:alpha="0.2"
                                android:background="@color/vf_primary"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/ivOut"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/ivAccepted"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/ivPicked"
                                app:layout_constraintHorizontal_bias="0.1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_timeline_checked" />

                            <ImageView
                                android:id="@+id/ivPicked"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/ivOut"
                                app:layout_constraintStart_toEndOf="@id/ivAccepted"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_timeline_checked" />

                            <ImageView
                                android:id="@+id/ivOut"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/ivDelivered"
                                app:layout_constraintStart_toEndOf="@id/ivPicked"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_timeline_active" />

                            <ImageView
                                android:id="@+id/ivDelivered"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.9"
                                app:layout_constraintStart_toEndOf="@id/ivOut"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_timeline_pending" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="ACCEPTED"
                                android:textSize="9sp" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="PICKED UP"
                                android:textSize="9sp" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="OUT FOR\nDELIVERY"
                                android:textColor="@color/vf_primary"
                                android:textSize="9sp" />

                            <TextView
                                style="@style/Stitch.Typography.LabelMedium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="DELIVERED"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/stitch_xl"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrack"
                            style="@style/Stitch.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="@dimen/stitch_sm"
                            android:layout_weight="1"
                            android:text="Track Delivery"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_route"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetails"
                            style="@style/Stitch.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="@dimen/stitch_sm"
                            android:layout_weight="1"
                            android:text="View Details"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/vf_primary"
                            app:strokeWidth="1.5dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Theme.Quick_Drop.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/bottom_nav_icon_selector"
        app:itemTextColor="@color/bottom_nav_text_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/sender_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <action
        android:id="@+id/action_global_to_login"
        app:destination="@id/loginFragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_to_senderDashboard"
        app:destination="@id/senderDashboardFragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_to_partnerDashboard"
        app:destination="@id/partnerDashboardFragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.quick_drop.ui.WelcomeFragment"
        android:label="QuickDrop"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.quick_drop.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_selection"
            app:destination="@id/accountSelectionFragment" />
        <action
            android:id="@+id/action_login_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/accountSelectionFragment"
        android:name="com.example.quick_drop.ui.AccountSelectionFragment"
        android:label="Account Selection"
        tools:layout="@layout/fragment_account_selection">
        <action
            android:id="@+id/action_selection_to_senderSignup"
            app:destination="@id/senderSignUpFragment" />
        <action
            android:id="@+id/action_selection_to_partnerSignup"
            app:destination="@id/partnerSignUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/senderSignUpFragment"
        android:name="com.example.quick_drop.ui.SenderSignUpFragment"
        android:label="Sender Sign Up"
        tools:layout="@layout/fragment_sender_signup">
        <action
            android:id="@+id/action_senderSignup_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/partnerSignUpFragment"
        android:name="com.example.quick_drop.ui.PartnerSignUpFragment"
        android:label="Partner Sign Up"
        tools:layout="@layout/fragment_partner_signup">
        <action
            android:id="@+id/action_partnerSignup_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Sender Flow -->
    <fragment
        android:id="@+id/senderDashboardFragment"
        android:name="com.example.quick_drop.ui.SenderDashboardFragment"
        android:label="Sender Dashboard"
        tools:layout="@layout/fragment_sender_dashboard">
        <action
            android:id="@+id/action_senderDashboard_to_createDelivery"
            app:destination="@id/createDeliveryFragment" />
        <action
            android:id="@+id/action_senderDashboard_to_profile"
            app:destination="@id/senderProfileFragment" />
        <action
            android:id="@+id/action_senderDashboard_to_deliveries"
            app:destination="@id/deliveriesFragment" />
        <action
            android:id="@+id/action_senderDashboard_to_orderHistory"
            app:destination="@id/orderHistorySenderFragment" />
        <action
            android:id="@+id/action_senderDashboard_to_tracking"
            app:destination="@id/orderTrackingFragment" />
        <action
            android:id="@+id/action_senderDashboard_to_orderDetails"
            app:destination="@id/orderDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/createDeliveryFragment"
        android:name="com.example.quick_drop.ui.CreateDeliveryFragment"
        android:label="Create Delivery"
        tools:layout="@layout/fragment_create_delivery">
        <action
            android:id="@+id/action_createDelivery_to_orderConfirmation"
            app:destination="@id/orderConfirmationFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderConfirmationFragment"
        android:name="com.example.quick_drop.ui.OrderConfirmationFragment"
        android:label="Confirm Delivery"
        tools:layout="@layout/fragment_order_confirmation">
        <action
            android:id="@+id/action_orderConfirmation_to_payment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.quick_drop.ui.PaymentFragment"
        android:label="Payment"
        tools:layout="@layout/fragment_payment">
        <action
            android:id="@+id/action_paymentFragment_to_paymentSuccess"
            app:destination="@id/paymentSuccessFragment"
            app:popUpTo="@id/senderDashboardFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/paymentSuccessFragment"
        android:name="com.example.quick_drop.ui.PaymentSuccessFragment"
        android:label="Payment Success"
        tools:layout="@layout/fragment_payment_success">
        <action
            android:id="@+id/action_paymentSuccess_to_tracking"
            app:destination="@id/orderTrackingFragment" />
        <action
            android:id="@+id/action_paymentSuccess_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/deliveriesFragment"
        android:name="com.example.quick_drop.ui.DeliveriesFragment"
        android:label="Active Deliveries"
        tools:layout="@layout/fragment_deliveries">
        <action
            android:id="@+id/action_deliveries_to_tracking"
            app:destination="@id/orderTrackingFragment" />
        <action
            android:id="@+id/action_deliveries_to_orderDetails"
            app:destination="@id/orderDetailsFragment" />
        <action
            android:id="@+id/action_deliveries_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_deliveries_to_orderHistory"
            app:destination="@id/orderHistorySenderFragment" />
        <action
            android:id="@+id/action_deliveries_to_senderProfile"
            app:destination="@id/senderProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderHistorySenderFragment"
        android:name="com.example.quick_drop.ui.OrderHistorySenderFragment"
        android:label="Order History"
        tools:layout="@layout/fragment_order_history_sender">
        <action
            android:id="@+id/action_orderHistory_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_orderHistory_to_deliveries"
            app:destination="@id/deliveriesFragment" />
        <action
            android:id="@+id/action_orderHistory_to_senderProfile"
            app:destination="@id/senderProfileFragment" />
        <action
            android:id="@+id/action_orderHistory_to_orderDetails"
            app:destination="@id/orderDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailsFragment"
        android:name="com.example.quick_drop.ui.OrderDetailsFragment"
        android:label="Order Details"
        tools:layout="@layout/fragment_order_details">
        <action
            android:id="@+id/action_orderDetails_to_tracking"
            app:destination="@id/orderTrackingFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderTrackingFragment"
        android:name="com.example.quick_drop.ui.OrderTrackingFragment"
        android:label="Order Tracking"
        tools:layout="@layout/fragment_order_tracking">
        <action
            android:id="@+id/action_tracking_to_details"
            app:destination="@id/orderDetailsFragment" />
        <action
            android:id="@+id/action_tracking_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_tracking_to_deliveries"
            app:destination="@id/deliveriesFragment" />
        <action
            android:id="@+id/action_tracking_to_orderHistory"
            app:destination="@id/orderHistorySenderFragment" />
        <action
            android:id="@+id/action_tracking_to_senderProfile"
            app:destination="@id/senderProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/senderProfileFragment"
        android:name="com.example.quick_drop.ui.SenderProfileFragment"
        android:label="Sender Profile"
        tools:layout="@layout/fragment_sender_profile">
        <action
            android:id="@+id/action_senderProfile_to_editProfile"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_senderProfile_to_tos"
            app:destination="@id/termsOfServiceFragment" />
        <action
            android:id="@+id/action_senderProfile_to_privacy"
            app:destination="@id/privacyPolicyFragment" />
        <action
            android:id="@+id/action_senderProfile_to_senderDashboard"
            app:destination="@id/senderDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_senderProfile_to_deliveries"
            app:destination="@id/deliveriesFragment" />
        <action
            android:id="@+id/action_senderProfile_to_orderHistory"
            app:destination="@id/orderHistorySenderFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.quick_drop.ui.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <!-- Partner Flow -->
    <fragment
        android:id="@+id/partnerDashboardFragment"
        android:name="com.example.quick_drop.ui.PartnerDashboardFragment"
        android:label="Partner Dashboard"
        tools:layout="@layout/fragment_partner_dashboard">
        <action
            android:id="@+id/action_partnerDashboard_to_deliveryInProgress"
            app:destination="@id/deliveryInProgressFragment" />
        <action
            android:id="@+id/action_partnerDashboard_to_availableRequests"
            app:destination="@id/availableRequestsFragment" />
        <action
            android:id="@+id/action_partnerDashboard_to_earnings"
            app:destination="@id/earningsFragment" />
        <action
            android:id="@+id/action_partnerDashboard_to_profile"
            app:destination="@id/partnerProfileFragment" />
        <action
            android:id="@+id/action_partnerDashboard_to_history"
            app:destination="@id/deliveryHistoryPartnerFragment" />
        <action
            android:id="@+id/action_partnerDashboard_to_partnerMap"
            app:destination="@id/partnerMapFragment" />
    </fragment>

    <fragment
        android:id="@+id/partnerMapFragment"
        android:name="com.example.quick_drop.ui.PartnerMapFragment"
        android:label="Delivery Map"
        tools:layout="@layout/fragment_partner_map" />

    <fragment
        android:id="@+id/availableRequestsFragment"
        android:name="com.example.quick_drop.ui.AvailableRequestsFragment"
        android:label="Available Requests"
        tools:layout="@layout/fragment_available_requests">
        <action
            android:id="@+id/action_availableRequests_to_details"
            app:destination="@id/deliveryRequestDetailsFragment" />
        <action
            android:id="@+id/action_availableRequests_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_availableRequests_to_history"
            app:destination="@id/deliveryHistoryPartnerFragment" />
        <action
            android:id="@+id/action_availableRequests_to_earnings"
            app:destination="@id/earningsFragment" />
        <action
            android:id="@+id/action_availableRequests_to_partnerProfile"
            app:destination="@id/partnerProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/deliveryRequestDetailsFragment"
        android:name="com.example.quick_drop.ui.DeliveryRequestDetailsFragment"
        android:label="Request Details"
        tools:layout="@layout/fragment_delivery_request_details">
        <action
            android:id="@+id/action_details_to_destDelivery"
            app:destination="@id/destinationDeliveryFragment" />
    </fragment>

    <fragment
        android:id="@+id/destinationDeliveryFragment"
        android:name="com.example.quick_drop.ui.DestinationDeliveryFragment"
        android:label="Destination Delivery"
        tools:layout="@layout/fragment_destination_delivery">
        <action
            android:id="@+id/action_destDelivery_to_pickupConfirmation"
            app:destination="@id/pickupConfirmationFragment" />
    </fragment>

    <fragment
        android:id="@+id/deliveryInProgressFragment"
        android:name="com.example.quick_drop.ui.DeliveryInProgressFragment"
        android:label="Delivery In Progress"
        tools:layout="@layout/fragment_delivery_in_progress">
        <action
            android:id="@+id/action_inProgress_to_proofOfDelivery"
            app:destination="@id/proofOfDeliveryFragment" />
    </fragment>

    <fragment
        android:id="@+id/proofOfDeliveryFragment"
        android:name="com.example.quick_drop.ui.ProofOfDeliveryFragment"
        android:label="Proof of Delivery"
        tools:layout="@layout/fragment_proof_of_delivery">
        <action
            android:id="@+id/action_proofOfDelivery_to_completed"
            app:destination="@id/deliveryCompletedFragment"
            app:popUpTo="@id/partnerDashboardFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/deliveryCompletedFragment"
        android:name="com.example.quick_drop.ui.DeliveryCompletedFragment"
        android:label="Delivery Completed"
        tools:layout="@layout/fragment_delivery_completed">
        <action
            android:id="@+id/action_completed_to_dashboard"
            app:destination="@id/partnerDashboardFragment" />
        <action
            android:id="@+id/action_completed_to_earnings"
            app:destination="@id/earningsFragment" />
        <action
            android:id="@+id/action_completed_to_feedback"
            app:destination="@id/feedbackFragment" />
    </fragment>

    <fragment
        android:id="@+id/pickupConfirmationFragment"
        android:name="com.example.quick_drop.ui.PickupConfirmationFragment"
        android:label="Pickup Confirmation"
        tools:layout="@layout/fragment_pickup_confirmation">
        <action
            android:id="@+id/action_pickupConfirmation_to_deliveryInProgress"
            app:destination="@id/deliveryInProgressFragment" />
        <action
            android:id="@+id/action_pickupConfirmation_to_dashboard"
            app:destination="@id/partnerDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/deliveryHistoryPartnerFragment"
        android:name="com.example.quick_drop.ui.DeliveryHistoryPartnerFragment"
        android:label="Delivery History"
        tools:layout="@layout/fragment_delivery_history_partner">
        <action
            android:id="@+id/action_history_to_details"
            app:destination="@id/partnerDeliveryDetailsFragment" />
        <action
            android:id="@+id/action_history_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_history_to_availableRequests"
            app:destination="@id/availableRequestsFragment" />
        <action
            android:id="@+id/action_history_to_partnerProfile"
            app:destination="@id/partnerProfileFragment" />
        <action
            android:id="@+id/action_history_to_earnings"
            app:destination="@id/earningsFragment" />
    </fragment>

    <fragment
        android:id="@+id/partnerDeliveryDetailsFragment"
        android:name="com.example.quick_drop.ui.PartnerDeliveryDetailsFragment"
        android:label="Delivery Details"
        tools:layout="@layout/fragment_partner_delivery_details" />

    <fragment
        android:id="@+id/earningsFragment"
        android:name="com.example.quick_drop.ui.EarningsFragment"
        android:label="Earnings"
        tools:layout="@layout/fragment_earnings">
        <action
            android:id="@+id/action_earnings_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_earnings_to_availableRequests"
            app:destination="@id/availableRequestsFragment" />
        <action
            android:id="@+id/action_earnings_to_history"
            app:destination="@id/deliveryHistoryPartnerFragment" />
        <action
            android:id="@+id/action_earnings_to_partnerProfile"
            app:destination="@id/partnerProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/partnerProfileFragment"
        android:name="com.example.quick_drop.ui.PartnerProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_partner_profile">
        <action
            android:id="@+id/action_partnerProfile_to_editPartnerProfile"
            app:destination="@id/editPartnerProfileFragment" />
        <action
            android:id="@+id/action_partnerProfile_to_tos"
            app:destination="@id/termsOfServiceFragment" />
        <action
            android:id="@+id/action_partnerProfile_to_privacy"
            app:destination="@id/privacyPolicyFragment" />
        <action
            android:id="@+id/action_partnerProfile_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_partnerProfile_to_availableRequests"
            app:destination="@id/availableRequestsFragment" />
        <action
            android:id="@+id/action_partnerProfile_to_history"
            app:destination="@id/deliveryHistoryPartnerFragment" />
        <action
            android:id="@+id/action_partnerProfile_to_earnings"
            app:destination="@id/earningsFragment" />
    </fragment>

    <fragment
        android:id="@+id/editPartnerProfileFragment"
        android:name="com.example.quick_drop.ui.EditPartnerProfileFragment"
        android:label="Edit Partner Profile"
        tools:layout="@layout/fragment_edit_partner_profile" />

    <!-- Shared/Common -->
    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.example.quick_drop.ui.FeedbackFragment"
        android:label="Feedback"
        tools:layout="@layout/fragment_feedback">
        <action
            android:id="@+id/action_feedback_to_submitted"
            app:destination="@id/feedbackSubmittedFragment"
            app:popUpTo="@id/partnerDashboardFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/feedbackSubmittedFragment"
        android:name="com.example.quick_drop.ui.FeedbackSubmittedFragment"
        android:label="Feedback Submitted"
        tools:layout="@layout/fragment_feedback_submitted">
        <action
            android:id="@+id/action_feedbackSubmitted_to_partnerDashboard"
            app:destination="@id/partnerDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/termsOfServiceFragment"
        android:name="com.example.quick_drop.ui.TermsOfServiceFragment"
        android:label="Terms of Service"
        tools:layout="@layout/fragment_terms_of_service" >
        <action
            android:id="@+id/action_termsOfServiceFragment_to_privacyPolicyFragment"
            app:destination="@id/privacyPolicyFragment" />
    </fragment>

    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.example.quick_drop.ui.PrivacyPolicyFragment"
        android:label="Privacy Policy"
        tools:layout="@layout/fragment_privacy_policy" />

</navigation>
